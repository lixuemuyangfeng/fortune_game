{
  "name": "fortune-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "test": "npm run semantic:check && node --test test/config-validation.test.mjs",
    "test:e2e": "playwright test test/level-playtest.spec.mjs",
    "semantic:check": "node scripts/validate-level-semantics.mjs",
    "art:review": "node scripts/create-image-review.mjs",
    "art:states": "node scripts/create-state-contact-sheet.mjs",
    "art:nest:v2": "node scripts/create-nest-v2-candidates.mjs",
    "art:gate": "node scripts/validate-art-production.mjs",
    "art:stock:openai": "node scripts/generate-stock-layered-openai.mjs",
    "visual:qa": "node scripts/create-visual-qa.mjs",
    "visual:qa:all": "node scripts/create-all-visual-qa.mjs",
    "visual:gate": "node scripts/validate-visual-qa.mjs",
    "visual:gate:all": "node scripts/validate-all-visual-qa.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "ship": "scripts/commit-push.sh"
  },
  "dependencies": {
    "@vitejs/plugin-legacy": "^7.2.1",
    "phaser": "^3.90.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
